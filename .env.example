PORT=3000
SESSION_SECRET=change-me
ADMIN_EMAIL=michael.m.hulbert@gmail.com

# Supabase project URL (example: https://abcxyzcompany.supabase.co)
SUPABASE_URL=

# Public key used for read-only operations
SUPABASE_ANON_KEY=

# Service role key required for seed/migrate administration tasks
SUPABASE_SERVICE_ROLE_KEY=

# Preferred: Transaction pooler connection string from Supabase dashboard
SUPABASE_DB_POOLER_URL=

# Direct Postgres connection string from Supabase (for npm run migrate)
SUPABASE_DB_URL=

# Public bucket name where post images are stored
SUPABASE_STORAGE_BUCKET=catblog-images

# OpenAI key enables AI draft generation in admin
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
