<%- include("partials/head") %>
<%- include("partials/nav") %>
<% const basePath = typeof siteBasePath !== 'undefined' ? siteBasePath : ''; %>
<% const postBase = basePath ? `${basePath}/post` : '/post'; %>
<% const aboutHref = basePath ? `${basePath}/about` : '/about'; %>

<main id="main-content" class="main-shell">
  <section class="hero reveal-up">
    <div class="hero-layout <%= siteCat && siteCat.profileImage && siteCat.profileImage.src ? 'hero-layout-has-image' : '' %>">
      <div>
        <p class="eyebrow"><%= siteCat && siteCat.tag ? siteCat.tag : "Memorial Archive" %></p>
        <h1><%= siteCat ? `${siteCat.name} - ${siteCat.title}` : 'Java - The adventures of the most overqualified house cat' %></h1>
        <p>
          <%= siteCat && siteCat.backstory
            ? siteCat.backstory
            : 'Java was the main influance for this project. Sadly, in the middle of development, we were forced to euthanize her. Let this archive serve as a memory of her and the love she gave us.' %>
        </p>
        <div class="hero-actions">
          <% if (featuredPost) { %>
            <a class="button-primary" href="<%= postBase %>/<%= featuredPost.slug %>">Read Featured Entry</a>
          <% } %>
          <a class="button-ghost" href="<%= aboutHref %>">About <%= siteCat ? siteCat.name : 'Java' %></a>
        </div>
      </div>

      <% if (siteCat && siteCat.profileImage && siteCat.profileImage.src) { %>
        <img
          class="hero-profile-image"
          src="<%= siteCat.profileImage.src %>"
          alt="<%= siteCat.profileImage.alt %>"
          loading="lazy"
        />
      <% } %>
    </div>
  </section>

  <section class="stat-strip reveal-up" style="--delay: 90ms">
    <article>
      <p class="stat-value"><%= posts.length + (featuredPost ? 1 : 0) %></p>
      <p class="stat-label">Published Entries</p>
    </article>
    <article>
      <p class="stat-value">100%</p>
      <p class="stat-label">Cat-Approved Opinions</p>
    </article>
    <article>
      <p class="stat-value">24/7</p>
      <p class="stat-label">Bird Surveillance</p>
    </article>
  </section>

  <% if (featuredPost) { %>
    <section class="featured-post reveal-up" style="--delay: 120ms">
      <% if (featuredPost.coverImage) { %>
        <img
          class="featured-image"
          src="<%= featuredPost.coverImage.src %>"
          alt="<%= featuredPost.coverImage.alt %>"
          loading="lazy"
        />
      <% } %>
      <p class="eyebrow">Featured Post</p>
      <h2><a href="<%= postBase %>/<%= featuredPost.slug %>"><%= featuredPost.title %></a></h2>
      <p><%= featuredPost.shortBody %></p>
      <p class="post-meta">
        <span><%= formatDisplayDate(featuredPost.date, { month: "short", day: "numeric", year: "numeric" }) %></span>
        <span><%= featuredPost.readMinutes %> min read</span>
        <span><%= featuredPost.mood %></span>
      </p>
      <a class="read-link" href="<%= postBase %>/<%= featuredPost.slug %>">Continue reading</a>
    </section>
  <% } %>

  <section class="section-head reveal-up" style="--delay: 140ms">
    <p class="eyebrow">Archive Entries</p>
    <h2>Stories From <%= siteCat ? `${siteCat.name}'s Logbook` : "Java's Logbook" %></h2>
  </section>

  <section class="posts-grid post-archive-grid" aria-label="Recent blog posts">
    <% posts.forEach((post, index) => { %>
      <a
        class="post-card-link reveal-up"
        href="<%= postBase %>/<%= post.slug %>"
        style="--delay: <%= 170 + (index * 90) %>ms"
        aria-label="Read post: <%= post.title %>"
      >
        <article class="post-card post-archive-card">
          <% if (post.coverImage) { %>
            <img
              class="post-image"
              src="<%= post.coverImage.src %>"
              alt="<%= post.coverImage.alt %>"
              loading="lazy"
            />
          <% } %>
          <p class="post-meta">
            <span><%= formatDisplayDate(post.date, { month: "short", day: "numeric", year: "numeric" }) %></span>
            <span><%= post.readMinutes %> min read</span>
          </p>
          <h2><%= post.title %></h2>
        </article>
      </a>
    <% }) %>
  </section>

  <section class="gallery-cta reveal-up" style="--delay: 220ms">
    <p class="eyebrow">Photo Roll</p>
    <h2>Want More <%= siteCat ? siteCat.name : 'Java' %> Photos?</h2>
    <p>Browse all images in one place, grouped automatically from post media.</p>
    <a class="button-primary" href="<%= basePath ? `${basePath}/gallery` : '/gallery' %>">Open Gallery</a>
  </section>
</main>

<%- include("partials/footer") %>
