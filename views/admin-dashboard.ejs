<%- include("partials/head") %>
<%- include("partials/nav") %>

<main id="main-content" class="main-shell">
  <section class="section-head reveal-up">
    <p class="eyebrow">Admin</p>
    <h1><%= selectedCat ? `${selectedCat.name} Manager` : "Choose A Cat" %></h1>
    <p>
      <%= selectedCat
        ? "Use tabs to manage this cat's details, posts, new entries, and gallery."
        : "Start by selecting a cat card to manage that cat's posts and images." %>
    </p>
  </section>

  <% if (selectedCat) { %>
    <section class="reveal-up" style="--delay: 60ms">
      <%- include("partials/admin-cat-tabs") %>
    </section>
  <% } %>

  <section class="about-card admin-main-panel reveal-up" style="--delay: 70ms">
    <% if (selectedCat) { %>
      <p class="admin-hint admin-selected-cat-copy">
        <strong><%= selectedCat.name %></strong>
        <% if (selectedCat.tag) { %>
          <span>• <%= selectedCat.tag %></span>
        <% } %>
        <% if (selectedCat.title) { %>
          <span>• <%= selectedCat.title %></span>
        <% } %>
        <br />
        <% if (selectedCat.backstory) { %>
          <em><%= selectedCat.backstory %></em>
          <br />
        <% } %>
        <%= selectedCat.description || "No description yet." %>
        <% if (selectedCat.about) { %>
          <br />
          <span>About page copy is set.</span>
        <% } %>
      </p>

      <% if (saved && activeTab === "posts") { %>
        <p class="admin-success" role="status">Post saved successfully.</p>
      <% } %>
      <% if (catSaved && activeTab === "details") { %>
        <p class="admin-success" role="status">Cat details saved.</p>
      <% } %>
      <% if (error) { %>
        <p class="admin-error" role="alert"><%= error %></p>
      <% } %>

      <% if (activeTab === "details") { %>
        <form class="admin-form-grid" method="post" action="/admin/cat/save">
          <input type="hidden" name="catId" value="<%= selectedCat.id %>" />

          <label for="catName">Name</label>
          <input id="catName" name="name" type="text" value="<%= selectedCat.name %>" required />

          <div class="ai-label-row">
            <% if (locals.aiEnabled) { %>
              <button type="button" class="ai-field-btn" data-field="title" data-target="catTitle" aria-label="AI fill Title"><img src="/images/icons/ai.svg" width="14" height="14" alt="" /></button>
            <% } %>
            <label for="catTitle">Title</label>
          </div>
          <input
            id="catTitle"
            name="title"
            type="text"
            value="<%= selectedCat.title || '' %>"
            placeholder="The world's most overqualified cat"
            required
          />

          <div class="ai-label-row">
            <% if (locals.aiEnabled) { %>
              <button type="button" class="ai-field-btn" data-field="tag" data-target="catTag" aria-label="AI fill Tag"><img src="/images/icons/ai.svg" width="14" height="14" alt="" /></button>
            <% } %>
            <label for="catTag">Tag</label>
          </div>
          <input
            id="catTag"
            name="tag"
            type="text"
            value="<%= selectedCat.tag || '' %>"
            placeholder="Memorial Archive"
          />

          <label for="catSlug">Slug</label>
          <input id="catSlug" type="text" value="<%= selectedCat.slug %>" readonly />
          <p class="admin-hint">Slug stays stable because it maps to this cat's routes and bucket.</p>

          <div class="ai-label-row">
            <% if (locals.aiEnabled) { %>
              <button type="button" class="ai-field-btn" data-field="backstory" data-target="catBackstory" aria-label="AI fill Backstory"><img src="/images/icons/ai.svg" width="14" height="14" alt="" /></button>
            <% } %>
            <label for="catBackstory">Backstory</label>
          </div>
          <textarea id="catBackstory" name="backstory" rows="4" required><%= selectedCat.backstory || "" %></textarea>

          <div class="ai-label-row">
            <% if (locals.aiEnabled) { %>
              <button type="button" class="ai-field-btn" data-field="description" data-target="catDescription" data-supports-posts="true" aria-label="AI fill Description"><img src="/images/icons/ai.svg" width="14" height="14" alt="" /></button>
            <% } %>
            <label for="catDescription">Description</label>
          </div>
          <textarea id="catDescription" name="description" rows="5" required><%= selectedCat.description || "" %></textarea>

          <div class="ai-label-row">
            <% if (locals.aiEnabled) { %>
              <button type="button" class="ai-field-btn" data-field="about" data-target="catAbout" data-supports-posts="true" aria-label="AI fill About Page Content"><img src="/images/icons/ai.svg" width="14" height="14" alt="" /></button>
            <% } %>
            <label for="catAbout">About Page Content</label>
          </div>
          <textarea
            id="catAbout"
            name="about"
            rows="10"
            placeholder="Write the longer about-page story for this cat."
          ><%= selectedCat.about || "" %></textarea>
          <p class="admin-hint">This longer text is shown on <code>/<%= selectedCat.slug %>/about</code>.</p>

          <h2 class="admin-gallery-title">Select Profile Photo</h2>
          <p class="admin-hint">Choose an image from this cat's gallery to use on cat cards and profile sections.</p>

          <% if (selectedCat.profileImage && selectedCat.profileImage.src) { %>
            <img
              class="admin-profile-preview"
              src="<%= selectedCat.profileImage.src %>"
              alt="<%= selectedCat.profileImage.alt %>"
              loading="lazy"
            />
          <% } %>

          <label class="admin-checkbox admin-no-image-option">
            <input
              type="radio"
              name="profileImagePath"
              value=""
              <%= !selectedCat.profileImageStoragePath ? "checked" : "" %>
            />
            No profile photo
          </label>

          <% if (!galleryImages.length) { %>
            <p class="admin-error">No gallery images found. Upload in <a href="/admin/gallery?catId=<%= selectedCat.id %>">Manage Gallery</a>.</p>
          <% } %>

          <section class="admin-gallery-grid" aria-label="Profile photo picker">
            <% galleryImages.forEach((image) => { %>
              <article class="admin-gallery-card admin-gallery-picker-card">
                <img src="<%= image.publicUrl %>" alt="<%= image.name %>" loading="lazy" />
                <div class="admin-gallery-copy">
                  <p class="admin-gallery-path"><code><%= image.storagePath %></code></p>
                  <label class="admin-checkbox">
                    <input
                      type="radio"
                      name="profileImagePath"
                      value="<%= image.storagePath %>"
                      <%= selectedCat.profileImageStoragePath === image.storagePath ? "checked" : "" %>
                    />
                    Use This Image
                  </label>
                </div>
              </article>
            <% }) %>
          </section>

          <button class="button-primary" type="submit">Save Details</button>
        </form>
      <% } %>

      <% if (activeTab === "posts") { %>
        <div class="admin-table-wrap">
          <table class="admin-table" aria-label="Post list">
            <thead>
              <tr>
                <th>Title</th>
                <th>Date</th>
                <th>Mood</th>
                <th>Slug</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!posts.length) { %>
                <tr>
                  <td colspan="5">No posts yet for <%= selectedCat.name %>. Create the first one.</td>
                </tr>
              <% } %>
              <% posts.forEach((post) => { %>
                <tr>
                  <td><%= post.title %></td>
                  <td><%= formatDisplayDate(post.date, { month: "short", day: "numeric", year: "numeric" }) %></td>
                  <td><%= post.mood %></td>
                  <td><code><%= post.slug %></code></td>
                  <td>
                    <a class="read-link" href="/admin/edit/<%= post.id %>?catId=<%= selectedCat.id %>">Edit</a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    <% } else { %>
      <% if (newCatRequested) { %>
        <p class="admin-success" role="status">New cat management UI is coming next. Use this card as your placeholder for now.</p>
      <% } %>

      <section class="admin-cat-grid" aria-label="Cat list">
        <% cats.forEach((cat) => { %>
          <a class="admin-cat-card-link" href="/admin?catId=<%= cat.id %>&tab=details">
            <article class="admin-cat-card">
              <% if (cat.profileImage && cat.profileImage.src) { %>
                <img class="admin-cat-card-image" src="<%= cat.profileImage.src %>" alt="<%= cat.profileImage.alt %>" loading="lazy" />
              <% } else { %>
                <div class="admin-cat-card-placeholder"></div>
              <% } %>
              <h2 class="admin-cat-card-title">
                <span class="admin-cat-card-name"><%= cat.name %></span>
                <span class="admin-cat-card-sep"> &ndash; </span>
                <span class="admin-cat-card-subtitle"><%= cat.title || `${cat.name}'s Logbook` %></span>
              </h2>
            </article>
          </a>
        <% }) %>

        <a class="admin-cat-card-link" href="/admin?newCat=1">
          <article class="admin-cat-card admin-cat-card-new">
            <div class="admin-cat-card-placeholder admin-cat-card-placeholder-new"><img src="/images/icons/add.svg" width="48" height="48" alt="" /></div>
            <h2 class="admin-cat-card-title">
              <span class="admin-cat-card-name">New Cat</span>
            </h2>
          </article>
        </a>
      </section>

      <% if (siteSaved) { %>
        <p class="admin-success" role="status">Site about content saved.</p>
      <% } %>
      <% if (error) { %>
        <p class="admin-error" role="alert"><%= error %></p>
      <% } %>

      <form class="admin-form-grid" method="post" action="/admin/site/save">
        <input type="hidden" name="tab" value="details" />

        <h2 class="admin-gallery-title">Site About Content</h2>
        <p class="admin-hint">This controls the content shown on the main <code>/about</code> page for the CatBlog directory.</p>

        <div class="ai-label-row">
          <% if (locals.aiEnabled) { %>
            <button
              type="button"
              class="ai-field-btn"
              id="aiSiteAboutBtn"
              aria-label="AI fill Site About Content"
            ><img src="/images/icons/ai.svg" width="14" height="14" alt="" /></button>
          <% } %>
          <label for="siteAbout">Directory About Content</label>
        </div>
        <textarea
          id="siteAbout"
          name="directoryAbout"
          rows="8"
          placeholder="Write the About page story for the CatBlog directory."
          required
        ><%= siteAbout || "" %></textarea>

        <button class="button-primary" type="submit">Save Site About</button>
      </form>
    <% } %>
  </section>
</main>

<%- include("partials/footer") %>

<% if (locals.aiEnabled && selectedCat && activeTab === 'details') { %>
<div class="ai-field-overlay" id="aiFieldOverlay" hidden>
  <div class="ai-field-popup" role="dialog" aria-modal="true" aria-labelledby="aiFieldPopupTitle">
    <h3 class="ai-field-popup-title" id="aiFieldPopupTitle">Fill with AI</h3>
    <p class="ai-field-popup-hint">Describe what you want. If there&rsquo;s already content in the field you can reference it (e.g. &ldquo;make this more funny&rdquo;).</p>
    <textarea id="aiFieldPopupPrompt" class="ai-field-popup-textarea" rows="4" placeholder="Describe what you want..."></textarea>
    <p class="admin-error ai-field-popup-error" id="aiFieldPopupError" hidden></p>
    <div class="ai-field-popup-actions">
      <button type="button" class="button-primary" id="aiFieldPopupSubmit">Generate</button>
      <button type="button" class="button-ghost" id="aiFieldPopupFromPosts" hidden>Generate from All Posts</button>
      <button type="button" class="button-ghost" id="aiFieldPopupCancel">Cancel</button>
    </div>
  </div>
</div>
<script>
(function () {
  var overlay = document.getElementById("aiFieldOverlay");
  if (!overlay) return;

  var promptInput = document.getElementById("aiFieldPopupPrompt");
  var submitBtn = document.getElementById("aiFieldPopupSubmit");
  var fromPostsBtn = document.getElementById("aiFieldPopupFromPosts");
  var cancelBtn = document.getElementById("aiFieldPopupCancel");
  var errorEl = document.getElementById("aiFieldPopupError");

  var currentField = null;
  var currentTarget = null;
  var currentCatId = null;

  function getCatId() {
    var input = document.querySelector('input[name="catId"]');
    return input ? input.value : "";
  }

  function openPopup(field, targetId, supportsPosts) {
    currentField = field;
    currentTarget = targetId;
    currentCatId = getCatId();
    promptInput.value = "";
    errorEl.hidden = true;
    errorEl.textContent = "";
    fromPostsBtn.hidden = !supportsPosts;
    overlay.hidden = false;
    promptInput.focus();
  }

  function closePopup() {
    overlay.hidden = true;
    currentField = null;
    currentTarget = null;
  }

  function setLoading(loading) {
    submitBtn.disabled = loading;
    fromPostsBtn.disabled = loading;
    cancelBtn.disabled = loading;
    submitBtn.textContent = loading ? "Generating\u2026" : "Generate";
  }

  async function generate(usePostsContext) {
    var prompt = promptInput.value.trim();
    if (!usePostsContext && !prompt) {
      errorEl.textContent = "Please enter a prompt.";
      errorEl.hidden = false;
      return;
    }
    var targetEl = document.getElementById(currentTarget);
    var currentValue = targetEl ? targetEl.value : "";
    errorEl.hidden = true;
    setLoading(true);
    try {
      var resp = await fetch("/admin/cat/ai-field", {
        method: "POST",
        credentials: "same-origin",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          catId: currentCatId,
          field: currentField,
          prompt: prompt,
          currentValue: currentValue,
          usePostsContext: usePostsContext,
        }),
      });
      var data = await resp.json();
      if (!resp.ok || data.error) throw new Error(data.error || "Generation failed.");
      if (targetEl) targetEl.value = data.result;
      closePopup();
    } catch (err) {
      errorEl.textContent = err.message;
      errorEl.hidden = false;
    } finally {
      setLoading(false);
    }
  }

  document.querySelectorAll(".ai-field-btn").forEach(function (btn) {
    btn.addEventListener("click", function () {
      openPopup(btn.dataset.field, btn.dataset.target, btn.dataset.supportsPosts === "true");
    });
  });

  submitBtn.addEventListener("click", function () { generate(false); });
  fromPostsBtn.addEventListener("click", function () { generate(true); });
  cancelBtn.addEventListener("click", closePopup);
  overlay.addEventListener("click", function (e) { if (e.target === overlay) closePopup(); });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !overlay.hidden) closePopup(); });
}());
</script>
<% } %>

<% if (locals.aiEnabled && !selectedCat) { %>
<div class="ai-field-overlay" id="aiSiteAboutOverlay" hidden>
  <div class="ai-field-popup" role="dialog" aria-modal="true" aria-labelledby="aiSiteAboutPopupTitle">
    <h3 class="ai-field-popup-title" id="aiSiteAboutPopupTitle">Generate Site About Content</h3>
    <p class="ai-field-popup-hint">Describe the voice and content you want on the CatBlog directory About page.</p>
    <textarea id="aiSiteAboutPrompt" class="ai-field-popup-textarea" rows="4" placeholder="Describe what you want..."></textarea>
    <p class="admin-error ai-field-popup-error" id="aiSiteAboutError" hidden></p>
    <div class="ai-field-popup-actions">
      <button type="button" class="button-primary" id="aiSiteAboutSubmit">Generate</button>
      <button type="button" class="button-ghost" id="aiSiteAboutCancel">Cancel</button>
    </div>
  </div>
</div>
<script>
(function () {
  var openBtn = document.getElementById("aiSiteAboutBtn");
  var overlay = document.getElementById("aiSiteAboutOverlay");
  var promptInput = document.getElementById("aiSiteAboutPrompt");
  var submitBtn = document.getElementById("aiSiteAboutSubmit");
  var cancelBtn = document.getElementById("aiSiteAboutCancel");
  var errorEl = document.getElementById("aiSiteAboutError");
  var targetEl = document.getElementById("siteAbout");

  if (!openBtn || !overlay || !promptInput || !submitBtn || !cancelBtn || !errorEl || !targetEl) {
    return;
  }

  function openPopup() {
    promptInput.value = "";
    errorEl.hidden = true;
    errorEl.textContent = "";
    overlay.hidden = false;
    promptInput.focus();
  }

  function closePopup() {
    overlay.hidden = true;
  }

  function setLoading(loading) {
    submitBtn.disabled = loading;
    cancelBtn.disabled = loading;
    submitBtn.textContent = loading ? "Generating\u2026" : "Generate";
  }

  async function generate() {
    var prompt = promptInput.value.trim();
    if (!prompt) {
      errorEl.textContent = "Please enter a prompt.";
      errorEl.hidden = false;
      return;
    }
    errorEl.hidden = true;
    setLoading(true);
    try {
      var resp = await fetch("/admin/site/ai-about", {
        method: "POST",
        credentials: "same-origin",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          prompt: prompt,
          currentValue: targetEl.value || "",
        }),
      });
      var data = await resp.json();
      if (!resp.ok || data.error) throw new Error(data.error || "Generation failed.");
      targetEl.value = data.result;
      closePopup();
    } catch (err) {
      errorEl.textContent = err.message;
      errorEl.hidden = false;
    } finally {
      setLoading(false);
    }
  }

  openBtn.addEventListener("click", openPopup);
  submitBtn.addEventListener("click", generate);
  cancelBtn.addEventListener("click", closePopup);
  overlay.addEventListener("click", function (e) { if (e.target === overlay) closePopup(); });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !overlay.hidden) closePopup(); });
}());
</script>
<% } %>
