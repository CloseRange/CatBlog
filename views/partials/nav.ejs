<header class="site-nav-wrap">
  <% const activePath = typeof currentPath !== 'undefined' ? currentPath : ''; %>
  <% const basePath = typeof siteBasePath !== 'undefined' ? siteBasePath : ''; %>
  <% const rootHref = '/'; %>
  <% const homeHref = basePath ? basePath : rootHref; %>
  <% const galleryHref = basePath ? `${basePath}/gallery` : '/gallery'; %>
  <% const aboutHref = basePath ? `${basePath}/about` : '/about'; %>
  <% const brandLabel = 'CatBlog'; %>
  <% const blogHomeLabel = basePath
    ? (typeof blogNavLabel !== 'undefined' && blogNavLabel
      ? blogNavLabel
      : (typeof siteBrand !== 'undefined' ? siteBrand : 'Blog Home'))
    : 'Home'; %>
  <nav class="site-nav" aria-label="Primary">
    <a class="brand" href="<%= rootHref %>">
      <span class="brand-icon">=^.^=</span>
      <span><%= brandLabel %></span>
    </a>
    <div class="nav-links">
      <a href="<%= homeHref %>" class="<%= activePath === '/' ? 'is-active' : '' %>" aria-current="<%= activePath === '/' ? 'page' : 'false' %>"><%= blogHomeLabel %></a>
      <a href="<%= aboutHref %>" class="<%= activePath === '/about' ? 'is-active' : '' %>" aria-current="<%= activePath === '/about' ? 'page' : 'false' %>">About</a>
      <% if (basePath) { %>
        <a href="<%= galleryHref %>" class="<%= activePath === '/gallery' ? 'is-active' : '' %>" aria-current="<%= activePath === '/gallery' ? 'page' : 'false' %>">Gallery</a>
      <% } %>
      <% if (locals.isAdmin) { %>
        <form class="nav-logout-form" method="post" action="/admin/logout">
          <button class="nav-logout-btn" type="submit">Logout</button>
        </form>
      <% } %>
    </div>
  </nav>
</header>
