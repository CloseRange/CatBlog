    <footer class="site-footer">
      <% const footerCats = Array.isArray(footerCatLinks) ? footerCatLinks : []; %>
      <p>
        CatBlog directory for exploring each cat's blog and preserving Java's memorial archive.
      </p>
      <div class="footer-links">
        <a href="/">Home</a>
        <% footerCats.forEach((cat) => { %>
          <a href="/<%= cat.slug %>"><%= cat.name %>'s Blog</a>
        <% }) %>
        <a href="/gallery">Full Gallery</a>
        <a href="/about">About</a>
        <a href="/admin">Admin</a>
      </div>
      <p class="footer-note">&copy; <%= new Date().getFullYear() %> CatBlog</p>
    </footer>
    <script src="/script.js"></script>
  </body>
</html>
