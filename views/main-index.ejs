<%- include("partials/head") %>
<%- include("partials/nav") %>

<main id="main-content" class="main-shell main-home">
  <% if (recentPosts && recentPosts.length) { %>
    <section class="main-home-hero reveal-up" aria-label="Recent posts spotlight">
      <div class="main-home-hero-head">
        <p class="main-eyebrow">Recent Posts</p>
        <h1>Fresh From The Cat Chronicles</h1>
      </div>
      <div class="home-carousel" data-home-carousel>
        <div class="home-carousel-track" aria-live="polite">
          <% recentPosts.forEach((post, index) => { %>
            <article
              class="home-slide <%= index === 0 ? 'is-active' : '' %>"
              data-home-slide
              data-post-href="<%= post.href %>"
              tabindex="0"
              role="link"
              aria-label="Open post: <%= post.title %>"
            >
              <% if (post.coverImage && post.coverImage.src) { %>
                <img
                  class="home-slide-image"
                  src="<%= post.coverImage.src %>"
                  alt="<%= post.coverImage.alt || post.title %>"
                  loading="lazy"
                />
              <% } %>
              <div class="home-slide-copy">
                <p class="home-slide-meta">
                  <span><%= formatDisplayDate(post.date) %></span>
                  <% if (post.mood) { %><span>•</span><span><%= post.mood %></span><% } %>
                </p>
                <h2><%= post.title %></h2>
                <p><%= post.shortBody %></p>
                <p class="home-slide-cta">Read Post</p>
              </div>
            </article>
          <% }) %>
        </div>
        <% if (recentPosts.length > 1) { %>
          <div class="home-carousel-controls">
            <div class="home-carousel-dots" role="tablist" aria-label="Recent posts slider controls">
              <% recentPosts.forEach((post, index) => { %>
                <button
                  class="home-dot <%= index === 0 ? 'is-active is-progressing' : '' %>"
                  type="button"
                  data-carousel-dot="<%= index %>"
                  aria-label="Show slide <%= index + 1 %>: <%= post.title %>"
                  aria-selected="<%= index === 0 ? 'true' : 'false' %>"
                ></button>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>
    </section>
  <% } %>

  <% if (availableBlogs && availableBlogs.length) { %>
    <section id="available-blogs" class="section-head reveal-up" style="--delay: 110ms">
      <p class="eyebrow">Available Blogs</p>
      <h2>Choose A Cat</h2>
    </section>

    <section class="posts-grid cat-directory-grid" aria-label="Available cat blogs">
      <% availableBlogs.forEach((blog, index) => { %>
        <% if (blog.isLive) { %>
          <a
            class="blog-card-link reveal-up"
            href="<%= blog.href %>"
            style="--delay: <%= 130 + (index * 60) %>ms"
            aria-label="Enter <%= blog.title %>"
          >
            <article class="post-card blog-card">
              <% if (blog.profileImage && blog.profileImage.src) { %>
                <img class="blog-card-image" src="<%= blog.profileImage.src %>" alt="<%= blog.profileImage.alt %>" loading="lazy" />
              <% } %>
              <p class="post-chip"><%= blog.tag %></p>
              <h2 class="blog-card-title">
                <span class="blog-card-name"><%= blog.name %></span>
                <span class="blog-card-sep"> - </span>
                <span class="blog-card-subtitle"><%= blog.title %></span>
              </h2>
              <p><%= blog.description %></p>
            </article>
          </a>
        <% } else { %>
          <article class="post-card blog-card blog-card-is-disabled reveal-up" style="--delay: <%= 130 + (index * 60) %>ms" aria-disabled="true">
            <% if (blog.profileImage && blog.profileImage.src) { %>
              <img class="blog-card-image" src="<%= blog.profileImage.src %>" alt="<%= blog.profileImage.alt %>" loading="lazy" />
            <% } %>
            <p class="post-chip"><%= blog.tag %></p>
            <h2 class="blog-card-title">
              <span class="blog-card-name"><%= blog.name %></span>
              <span class="blog-card-sep"> - </span>
              <span class="blog-card-subtitle"><%= blog.title %></span>
            </h2>
            <p><%= blog.description %></p>
          </article>
        <% } %>
      <% }) %>
    </section>
  <% } else { %>
    <section class="main-card reveal-up" style="--delay: 100ms">
      <h2>No Blogs Added Yet</h2>
      <p>
        Add blog entries in this template to publish your cat selector cards on
        the homepage.
      </p>
    </section>
  <% } %>
</main>

<%- include("partials/footer") %>
