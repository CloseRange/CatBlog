<%- include("partials/head") %>
<%- include("partials/nav") %>

<main id="main-content" class="main-shell main-home">
  <section class="main-hero reveal-up">
    <p class="main-eyebrow">CatBlog Directory</p>
    <h1>Pick A Cat Blog To Visit</h1>
    <p>
      This home page is now your blog selector. Choose a cat profile to enter
      that blog.
    </p>
    <div class="main-actions">
      <a class="main-btn" href="/java">Enter Java's Blog</a>
      <a class="main-btn main-btn-ghost" href="/about">How This Works</a>
    </div>
  </section>

  <% if (availableBlogs && availableBlogs.length) { %>
    <section class="section-head reveal-up" style="--delay: 110ms">
      <p class="eyebrow">Available Blogs</p>
      <h2>Choose A Cat</h2>
    </section>

    <section class="posts-grid" aria-label="Available cat blogs">
      <% availableBlogs.forEach((blog, index) => { %>
        <article class="post-card reveal-up" style="--delay: <%= 130 + (index * 60) %>ms">
          <p class="post-chip"><%= blog.name %></p>
          <h2><%= blog.title %></h2>
          <p><%= blog.description %></p>
          <% if (blog.isLive) { %>
            <a class="main-btn" href="<%= blog.href %>">Visit Blog</a>
          <% } else { %>
            <span class="main-btn main-btn-ghost" aria-disabled="true">Coming Soon</span>
          <% } %>
        </article>
      <% }) %>
    </section>
  <% } else { %>
    <section class="main-card reveal-up" style="--delay: 100ms">
      <h2>No Blogs Added Yet</h2>
      <p>
        Add blog entries in this template to publish your cat selector cards on
        the homepage.
      </p>
    </section>
  <% } %>
</main>

<%- include("partials/footer") %>
