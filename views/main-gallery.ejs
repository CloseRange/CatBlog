<%- include("partials/head") %>
<%- include("partials/nav") %>

<main id="main-content" class="main-shell">
  <section class="section-head reveal-up">
    <p class="eyebrow">Gallery</p>
    <h1>All Blog Photos</h1>
  </section>

  <% if (!galleryItems || !galleryItems.length) { %>
    <section class="main-card reveal-up" style="--delay: 90ms">
      <h2>No photos yet</h2>
      <p>
        Upload images from <a href="/admin/gallery">Admin Gallery</a> and they
        will appear here automatically.
      </p>
      <p>Suggested folder: <code>java/</code>.</p>
    </section>
  <% } %>

  <% if (galleryItems && galleryItems.length) { %>
    <section class="gallery-grid" aria-label="All cat blog photos">
      <% galleryItems.forEach((item, index) => { %>
        <article class="gallery-card reveal-up" style="--delay: <%= 80 + (index * 60) %>ms">
          <a
            class="gallery-image-link"
            href="<%= item.src %>"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View image <%= index + 1 %>"
          >
            <img src="<%= item.src %>" alt="<%= item.alt %>" loading="lazy" />
          </a>
        </article>
      <% }) %>
    </section>
  <% } %>
</main>

<%- include("partials/footer") %>
