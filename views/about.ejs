<%- include("partials/head") %>
<%- include("partials/nav") %>

<main id="main-content" class="main-shell">
  <section class="about-card reveal-up">
    <p class="eyebrow">About This Memorial</p>
    <h1>Who Is <%= siteCat ? siteCat.name : 'Java' %>?</h1>
    <% if (siteCat && siteCat.profileImage && siteCat.profileImage.src) { %>
      <img class="about-profile-image" src="<%= siteCat.profileImage.src %>" alt="<%= siteCat.profileImage.alt %>" loading="lazy" />
    <% } %>
    <% const aboutContent = (siteCat && siteCat.about) || ''; %>
    <% const aboutParagraphs = aboutContent
      ? aboutContent.split(/\n\s*\n/).map((chunk) => chunk.trim()).filter(Boolean)
      : []; %>

    <% if (aboutParagraphs.length) { %>
      <% aboutParagraphs.forEach((paragraph) => { %>
        <p><%= paragraph %></p>
      <% }) %>
    <% } else { %>
      <p>
        <%= siteCat && siteCat.title
          ? `${siteCat.name} was ${siteCat.title.toLowerCase()}, with strong opinions about snacks, naps, and chewing absolutely everything in sight.`
          : 'Java was my real cat, with strong opinions about snacks, naps, and chewing absolutely everything in sight.' %>
      </p>
      <p>
        He had pica, so many entries are about the eternal struggle to keep socks,
        cardboard, and charging cables out of reach.
      </p>
      <p>
        <%= siteCat && siteCat.description
          ? `${siteCat.description} Posts and images are managed in Supabase, so updates are easy while keeping the archive focused.`
          : 'This memorial site preserves her memory through posts and images managed in Supabase, so updates are easy while keeping the archive focused.' %>
      </p>
      <p>
        Every page under <code><%= siteBasePath || '/java' %></code> is dedicated to <%= siteCat ? siteCat.name : 'Java' %>'s archive.
      </p>
    <% } %>

    <div class="about-highlights">
      <article>
        <h2>What's preserved</h2>
        <p><%= siteCat ? siteCat.name : 'Java' %>'s posts, moods, and memories are kept in the same Supabase-backed workflow used by admin.</p>
      </article>
      <article>
        <h2>Media archive</h2>
        <p>Photos are served from Supabase Storage and tied to each post with image metadata.</p>
      </article>
      <article>
        <h2>Blog selector</h2>
        <p>The root page acts as a directory so visitors can choose <%= siteCat ? `${siteCat.name}'s blog` : 'this blog' %> or other cat blogs.</p>
      </article>
    </div>
  </section>
</main>

<%- include("partials/footer") %>
